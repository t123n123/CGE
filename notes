let draw_card (player) = 
    let _ = handle_event( BeforeCardDrawn ) in 
    let card = player.get_zone(CardZones.deck).pop_card() in 
    let _ = player.get_zone(CardZones.hand).add_card(card) in 
    let _ = handle_event( AfterCardDrawn ) in 
    state 

(* +1/+1 to all allies *)
on_play = function (state) =
    state.events.get_event_type ( OnMinionEnterZone (Board) ).add_function 
        (event) ->  
            event.source.add_modifier( (Modifiers.Buff (1, 1)) ) 


    state.events.get_event_type ( OnCardLeaveZone (Board)).add_function 
        (event) -> 
            if event.card == this_card -> 
                this_card.disable_effects()
                ... remove +1 +1 buffs from all allied minions





Responsibilities:
- When to check for game win conditions -> Game Rules 
- Card entities -> Game engine 
- Card modifiers / attributes (counters, tribes, buffs, stats) -> Game engine 
- Resources -> Both 
- Card zone interface -> Game engine 
- Defining the possible card zones -> Game rules 
- Defining the event hooks -> Game rules 
- Handling the events -> Game engine 
- Aura effects -> Engine?
